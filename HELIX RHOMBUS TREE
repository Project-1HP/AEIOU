<body>
<canvas id="c"></canvas>

<div id="hud">
  <input id="seed" value="HIMELO-0001" spellcheck="false">
  <button id="go">Re-roll</button>
  <button id="save">PNG</button>
</div>

<div id="legend">
  <div><b>Surge × Roll</b> → helix angular speed</div>
  <div><b>Sway × Pitch</b> → helix radius</div>
  <div><b>Heave (Z)</b> → helix axis / spine</div>
</div>

<div id="meta">
  <div><span class="k">WORD ·</span> <b id="m-word">—</b></div>
  <div><span class="k">AUTO ·</span> <b id="m-auto">—</b></div>
  <div><span class="k">TREE ·</span> <b id="m-tree">—</b></div>
  <div><span class="k">HELIX ·</span> <b id="m-helix">—</b></div>
  <div><span class="k">ART ·</span> <b id="m-art">—</b></div>
</div>

<script>
(() => {
'use strict';

/* ════════════════════════════════════════════════════════════
   0 · DETERMINISTIC RNG
   ════════════════════════════════════════════════════════════ */
function hashStr(s){
  let h = 2166136261 >>> 0;
  for (let i=0;i<s.length;i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
  return h >>> 0;
}
function mulberry32(a){
  return function(){
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

/* ════════════════════════════════════════════════════════════
   1 · AEIOU PALETTES
   ════════════════════════════════════════════════════════════ */
const AEIOU = {
  A:{ p:'#FF4FA3', s:'#FFC2E0', ink:'#2A0016' },
  E:{ p:'#FF5A2B', s:'#FFC46B', ink:'#2A0A00' },
  I:{ p:'#F6F1E3', s:'#FFFFFF', ink:'#0E0E12' },
  O:{ p:'#2FE08A', s:'#8CF2FF', ink:'#00261A' },
  U:{ p:'#3D6BFF', s:'#B14CFF', ink:'#000B33' }
};

/* ════════════════════════════════════════════════════════════
   2 · CONSONANT CLASSES + ARTICULATION
   ════════════════════════════════════════════════════════════ */
const LETTER_CLASS = {
  B:'plosive', C:'plosive', D:'plosive', G:'plosive', K:'plosive',
  P:'plosive', Q:'plosive', T:'plosive',
  F:'fricative', H:'fricative', S:'fricative', V:'fricative', Z:'fricative', X:'fricative',
  J:'affricate',
  M:'nasal', N:'nasal',
  W:'approximant', Y:'approximant',
  R:'trill', L:'lateral'
};
const CLASS_COLOR = {
  plosive:     { p:'#FF7A1A', s:'#FFD08A', ink:'#2A1000' },
  fricative:   { p:'#00D1B2', s:'#A8FFF0', ink:'#00201C' },
  affricate:   { p:'#C6FF3D', s:'#F2FFB8', ink:'#1A2400' },
  nasal:       { p:'#B26BFF', s:'#E4CCFF', ink:'#1A0033' },
  approximant: { p:'#FFD400', s:'#FFF3B0', ink:'#2A2000' },
  lateral:     { p:'#2AA8FF', s:'#B8E2FF', ink:'#001A2A' },
  trill:       { p:'#FF2E63', s:'#FFB3C4', ink:'#2A0010' },
  tap:         { p:'#9AA0A6', s:'#DDE1E6', ink:'#141418' },
  vowel:       { p:'#E8E8F0', s:'#FFFFFF', ink:'#0B0B10' }
};
const ARTICULATION = {
  plosive:     { edge:1.30, drip:1.80, glow:0.30, spray:0.40, label:'pl' },
  fricative:   { edge:0.88, drip:0.90, glow:0.55, spray:1.40, label:'fr' },
  affricate:   { edge:1.15, drip:1.60, glow:0.40, spray:1.00, label:'af' },
  nasal:       { edge:1.00, drip:1.20, glow:0.85, spray:0.60, label:'na' },
  approximant: { edge:0.82, drip:0.80, glow:0.65, spray:0.80, label:'ap' },
  lateral:     { edge:1.05, drip:1.20, glow:0.45, spray:0.60, label:'la' },
  trill:       { edge:1.20, drip:2.00, glow:0.50, spray:0.50, label:'tr' },
  tap:         { edge:0.95, drip:1.00, glow:0.35, spray:1.00, label:'ta' },
  vowel:       { edge:1.00, drip:1.10, glow:0.70, spray:0.50, label:'vo' }
};

function paletteFor(ch){
  const u = ch.toUpperCase();
  if (AEIOU[u]) return AEIOU[u];
  return CLASS_COLOR[LETTER_CLASS[u] || 'approximant'];
}
function artClassFor(ch){
  const u = ch.toUpperCase();
  if (AEIOU[u]) return 'vowel';
  return LETTER_CLASS[u] || 'approximant';
}
function artStyleFor(ch){
  return ARTICULATION[artClassFor(ch)] || ARTICULATION.approximant;
}

/* ════════════════════════════════════════════════════════════
   3 · AUTOMATON
   ════════════════════════════════════════════════════════════ */
const SIGMA = ['qp','dp','qb','db','∅','§','∆','©'];
const DELTA = {
  S1:{qp:'S2',dp:'S1',qb:'S3',db:'S2','∅':'S1','§':'S4','∆':'S3','©':'S5'},
  S2:{qp:'S3',dp:'S2',qb:'S4',db:'S1','∅':'S2','§':'S5','∆':'S4','©':'S1'},
  S3:{qp:'S4',dp:'S3',qb:'S5',db:'S2','∅':'S3','§':'S1','∆':'S5','©':'S2'},
  S4:{qp:'S5',dp:'S4',qb:'S1',db:'S3','∅':'S4','§':'S2','∆':'S1','©':'S3'},
  S5:{qp:'S1',dp:'S5',qb:'S2',db:'S4','∅':'S5','§':'S3','∆':'S2','©':'S4'}
};

/* ════════════════════════════════════════════════════════════
   4 · LEXICON + SIGILS
   ════════════════════════════════════════════════════════════ */
const LEX = [
  'HIMELO','AEIOU','RHOMBUS','HELIX','SURGE','SWAY','HEAVE',
  'YAW','PITCH','ROLL','CADIUS','OCTOVIRIS','PENTALLIUM',
  'HEXACORPUS','FORCE','POWER','AXIOM','ARTICULATE','TRUE'
];
const SIGILS = ['⅄','ᘔ','И','⇦','⇨','❴','❵','∧','ɿ','⊥'];
const FONT = '"Impact","Haettenschweiler","Arial Black","Franklin Gothic Heavy",sans-serif';

/* ════════════════════════════════════════════════════════════
   5 · CANVAS
   ════════════════════════════════════════════════════════════ */
const cv  = document.getElementById('c');
const ctx = cv.getContext('2d');
let W = 0, H = 0, DPR = 1;

function resize(){
  DPR = Math.min(2, window.devicePixelRatio || 1);
  W = cv.clientWidth; H = cv.clientHeight;
  cv.width  = Math.round(W * DPR);
  cv.height = Math.round(H * DPR);
}

/* ════════════════════════════════════════════════════════════
   6 · DRAW HELPERS
   ════════════════════════════════════════════════════════════ */
function shade(hex, amt){
  const n = parseInt(hex.slice(1), 16);
  let r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
  r = Math.round(r * (1 - amt));
  g = Math.round(g * (1 - amt));
  b = Math.round(b * (1 - amt));
  return `rgb(${r},${g},${b})`;
}
function drip(x, y, len, w, color){
  ctx.fillStyle = color;
  ctx.beginPath();
  ctx.moveTo(x - w * 0.5, y);
  ctx.quadraticCurveTo(x - w * 0.42, y + len * 0.72, x - w * 0.18, y + len * 0.92);
  ctx.quadraticCurveTo(x, y + len * 1.04, x + w * 0.18, y + len * 0.92);
  ctx.quadraticCurveTo(x + w * 0.42, y + len * 0.72, x + w * 0.5, y);
  ctx.closePath();
  ctx.fill();
  ctx.beginPath();
  ctx.arc(x, y + len * 1.02, w * 0.44, 0, Math.PI * 2);
  ctx.fill();
}
function sparkle(x, y, r, color){
  ctx.beginPath();
  ctx.moveTo(x, y - r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.quadraticCurveTo(x, y, x, y + r);
  ctx.quadraticCurveTo(x, y, x - r, y);
  ctx.quadraticCurveTo(x, y, x, y - r);
  ctx.fillStyle = color;
  ctx.fill();
}
function arrow(x, y, size, dir, color){
  ctx.save();
  ctx.translate(x, y);
  ctx.scale(dir, 1);
  ctx.beginPath();
  ctx.moveTo(-size * 0.5, -size * 0.16);
  ctx.lineTo( size * 0.10, -size * 0.16);
  ctx.lineTo( size * 0.10, -size * 0.38);
  ctx.lineTo( size * 0.55,  0);
  ctx.lineTo( size * 0.10,  size * 0.38);
  ctx.lineTo( size * 0.10,  size * 0.16);
  ctx.lineTo(-size * 0.5,   size * 0.16);
  ctx.closePath();
  ctx.fillStyle = color;
  ctx.fill();
  ctx.lineWidth = size * 0.07;
  ctx.strokeStyle = '#08080c';
  ctx.lineJoin = 'round';
  ctx.stroke();
  ctx.restore();
}
function crown(cx, y, w, color){
  const h = w * 0.52;
  ctx.beginPath();
  ctx.moveTo(cx - w * 0.5, y);
  ctx.lineTo(cx - w * 0.5, y - h * 0.55);
  ctx.lineTo(cx - w * 0.25, y - h * 0.16);
  ctx.lineTo(cx, y - h * 0.85);
  ctx.lineTo(cx + w * 0.25, y - h * 0.16);
  ctx.lineTo(cx + w * 0.5, y - h * 0.55);
  ctx.lineTo(cx + w * 0.5, y);
  ctx.closePath();
  ctx.fillStyle = color;
  ctx.fill();
  ctx.lineWidth = w * 0.045;
  ctx.lineJoin = 'round';
  ctx.strokeStyle = '#08080c';
  ctx.stroke();
}
function sprayDots(cx, cy, radius, density, color, rng){
  const count = Math.floor(density * 26);
  for (let i = 0; i < count; i++){
    const a = rng() * Math.PI * 2;
    const d = radius * (0.88 + rng() * 0.4);
    ctx.globalAlpha = 0.2 + rng() * 0.45;
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.arc(cx + Math.cos(a) * d, cy + Math.sin(a) * d, 0.4 + rng() * 1.9, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.globalAlpha = 1;
}
function drawRhombus(cx, cy, size, rotation, fill, light, outlineWeight, glow){
  ctx.save();
  ctx.translate(cx, cy);
  ctx.rotate(rotation);
  if (glow > 0){ ctx.shadowColor = fill; ctx.shadowBlur = size * glow; }
  ctx.beginPath();
  ctx.moveTo(0, -size);
  ctx.lineTo(size, 0);
  ctx.lineTo(0, size);
  ctx.lineTo(-size, 0);
  ctx.closePath();
  ctx.lineJoin = 'round';
  ctx.lineWidth = size * outlineWeight;
  ctx.strokeStyle = '#08080c';
  ctx.stroke();
  ctx.shadowBlur = 0;
  const g = ctx.createLinearGradient(0, -size, 0, size);
  g.addColorStop(0,   light);
  g.addColorStop(0.5, fill);
  g.addColorStop(1,   shade(fill, 0.45));
  ctx.fillStyle = g;
  ctx.fill();
  ctx.restore();
}

/* ════════════════════════════════════════════════════════════
   7 · RHOMBUS TREE
   ════════════════════════════════════════════════════════════ */
function buildRhombusTree(word, rng, W, H){
  const letters = word.split('');
  const n = letters.length;
  const baseX = W / 2;
  const baseY = H * 0.80;
  const topY  = H * 0.18;
  const span  = baseY - topY;

  const nodes = [];
  let prev = null;
  let cumSway = 0;
  let swayAmp = W * 0.13;

  for (let i = 0; i < n; i++){
    const t = n > 1 ? i / (n - 1) : 0.5;
    cumSway += (rng() - 0.5) * 1.4 * (0.6 + rng() * 0.6);
    const sway = Math.max(-1, Math.min(1, cumSway));
    const surge = 0.65 + rng() * 0.75;
    const roll = (rng() - 0.5) * 0.7;

    const x = baseX + sway * swayAmp * (1 - t * 0.55) + (rng() - 0.5) * 18;
    const y = baseY - t * span;

    const node = {
      x, y, z:i, t, sway, surge, roll,
      letter: letters[i].toUpperCase(),
      palette: paletteFor(letters[i]),
      art: artStyleFor(letters[i]),
      parent: prev, children:[], sideBranches:[]
    };
    nodes.push(node);
    if (prev) prev.children.push(node);
    prev = node;
  }

  // side branches (3-ary Y ∈ {-1, +1})
  for (const node of nodes){
    const want = rng() < 0.72 ? (rng() < 0.45 ? 2 : 1) : 0;
    const used = [];
    for (let b = 0; b < want; b++){
      let dir = rng() < 0.5 ? -1 : 1;
      if (used.includes(dir)) dir = -dir;
      used.push(dir);
      const len   = (0.10 + rng() * 0.17) * Math.min(W, H);
      const lean  = dir * (0.55 + rng() * 0.42);
      const angle = node.roll + lean;
      node.sideBranches.push({
        x: node.x + Math.sin(angle) * len,
        y: node.y - Math.cos(angle) * len,
        dir, angle,
        size: (0.35 + rng() * 0.32) * node.surge,
        roll: angle + (rng() - 0.5) * 0.35,
        tip: rng() < 0.55 ? 'rhombus' : (rng() < 0.55 ? 'spark' : 'drip'),
        palette: paletteFor(letters[(rng() * n) | 0])
      });
    }
  }
  return { nodes, word };
}

/* ════════════════════════════════════════════════════════════
   8 · HELIX POWER
   -----------------------------------------------------------------
   Surge × Roll  → cumulative angular advance per level
   Sway × Pitch  → radius of the helix cross-section per level
   Heave (Z)     → vertical progression (axis = tree spine)
   ════════════════════════════════════════════════════════════ */
function buildHelix(tree, style, rng){
  const nodes = tree.nodes;
  const n = nodes.length;
  if (n < 2) return { segs:[], totalTurns:0 };

  // 1 · cumulative angular progress per level
  //     target ≈ style.helixTurns over the full spine
  const basePerLevel = (style.helixTurns * Math.PI * 2) / Math.max(n - 1, 1);
  const levelAngles = [0];
  for (let i = 1; i < n; i++){
    const node = nodes[i];
    const prev = nodes[i - 1];
    const surge = node.surge * 0.6 + prev.surge * 0.4;
    const roll  = Math.abs(node.roll * 0.5 + prev.roll * 0.5);
    // Surge × Roll modulation of angular advance
    const mod = 0.75 + surge * 0.55 + roll * 1.20;
    levelAngles.push(levelAngles[i - 1] + basePerLevel * mod);
  }

  // 2 · sample helix along the spine
  const samplesPerLevel = 32;
  const totalSamples = (n - 1) * samplesPerLevel + 1;
  const baseR = Math.min(W, H) * 0.085;
  const segs = [];

  for (let i = 0; i < totalSamples; i++){
    const u   = i / (totalSamples - 1);
    const lvl = u * (n - 1);
    const i0  = Math.min(Math.floor(lvl), n - 1);
    const i1  = Math.min(i0 + 1, n - 1);
    const f   = lvl - i0;

    const a = nodes[i0];
    const b = nodes[i1];

    const sx = a.x * (1 - f) + b.x * f;
    const sy = a.y * (1 - f) + b.y * f;

    const sway  = a.sway  * (1 - f) + b.sway  * f;
    const surge = a.surge * (1 - f) + b.surge * f;
    const roll  = a.roll  * (1 - f) + b.roll  * f;

    const theta = levelAngles[i0] * (1 - f) + levelAngles[i1] * f;

    // Sway × Pitch modulation of radius
    const pitch = Math.abs(roll);
    const radius = baseR * (0.55 + Math.abs(sway) * 1.15 + pitch * 0.60);

    const hx = sx + radius * Math.cos(theta);
    const hy = sy + radius * Math.sin(theta) * style.helixSquash;
    const depth = Math.sin(theta); // -1 back · +1 front

    segs.push({
      x: hx, y: hy, sx, sy,
      depth, theta, radius,
      sway, surge, roll,
      palette:    a.palette,
      paletteB:   b.palette
    });
  }

  return {
    segs,
    totalTurns: levelAngles[levelAngles.length - 1] / (Math.PI * 2)
  };
}

function drawHelixSegment(a, b, alpha, style){
  const surge = (a.surge + b.surge) / 2;
  const coreW = 9 * style.helixThick * (0.7 + surge * 0.6);
  const outW  = coreW + 9;

  // dark outline
  ctx.strokeStyle = `rgba(8,8,12,${0.9 * alpha})`;
  ctx.lineWidth = outW;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(a.x, a.y);
  ctx.lineTo(b.x, b.y);
  ctx.stroke();

  // colored core
  const grad = ctx.createLinearGradient(a.x, a.y, b.x, b.y);
  grad.addColorStop(0, a.palette.p);
  grad.addColorStop(1, b.paletteB.p);
  ctx.strokeStyle = grad;
  ctx.globalAlpha = alpha * 0.88;
  ctx.lineWidth = coreW;
  ctx.stroke();
  ctx.globalAlpha = 1;

  // specular highlight on the front
  if (alpha > 0.7){
    ctx.strokeStyle = `rgba(255,255,255,${0.22 * alpha})`;
    ctx.lineWidth = coreW * 0.35;
    ctx.beginPath();
    ctx.moveTo(a.x, a.y - coreW * 0.22);
    ctx.lineTo(b.x, b.y - coreW * 0.22);
    ctx.stroke();
  }
}

function drawHelixHalf(helix, style, isFront){
  const segs = helix.segs;
  for (let i = 0; i < segs.length - 1; i++){
    const a = segs[i];
    const b = segs[i + 1];
    const d = (a.depth + b.depth) / 2;

    if (isFront){
      if (d <= 0) continue;
      // front: 0.5 → 1.0 as depth goes 0 → +1
      drawHelixSegment(a, b, 0.5 + d * 0.5, style);
    } else {
      if (d > 0) continue;
      // back: 0.15 → 0.5 as depth goes -1 → 0
      drawHelixSegment(a, b, 0.15 + (d + 1) * 0.35, style);
    }
  }
}

/* ════════════════════════════════════════════════════════════
   9 · RENDER
   ════════════════════════════════════════════════════════════ */
const OUT = { word:'—', auto:'—', tree:'—', helix:'—', art:'—' };

function render(seed){
  const rng    = mulberry32(hashStr(seed));
  const rr     = (a,b) => a + (b-a) * rng();
  const pick   = arr  => arr[(rng() * arr.length) | 0];
  const chance = p    => rng() < p;

  /* 9a · run the automaton --------------------------------- */
  let st = 'S1';
  const path = [st], syms = [];
  for (let i = 0; i < 14; i++){
    const sym = pick(SIGMA);
    syms.push(sym);
    st = DELTA[st][sym];
    path.push(st);
  }
  const count = s => syms.filter(x => x === s).length;

  /* 9b · style vector -------------------------------------- */
  const style = {
    tilt:        rr(-0.05, 0.05) + count('∆') * 0.012,
    shear:       rr(-0.10, 0.10),
    edgeMul:     1 + count('qb') * 0.08 + count('dp') * 0.04,
    dripMul:     1 + count('∅') * 0.30,
    glowMul:     0.8 + count('qp') * 0.10,
    arrowN:      count('§'),
    sparkleN:    5 + count('©') * 2,
    // Helix Power params
    helixTurns:  1.6 + count('∆') * 0.35 + count('©') * 0.15,
    helixThick:  0.85 + count('§') * 0.14,
    helixSquash: 0.30 + count('dp') * 0.035 + count('qb') * 0.02
  };

  /* 9c · word + tree + helix ------------------------------- */
  const word  = pick(LEX);
  const tree  = buildRhombusTree(word, rng, W, H);
  const helix = buildHelix(tree, style, rng);

  /* 9d · clear + wall ------------------------------------- */
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  ctx.clearRect(0, 0, W, H);

  const bg = ctx.createRadialGradient(
    W * 0.5, H * 0.45, 0, W * 0.5, H * 0.5, Math.max(W, H) * 0.78
  );
  bg.addColorStop(0,    '#14141c');
  bg.addColorStop(0.55, '#0c0c12');
  bg.addColorStop(1,    '#050508');
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, W, H);

  // ambient tint from first letter
  const hero = tree.nodes[0].palette;
