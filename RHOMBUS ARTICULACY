<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>HIMELO · Rhombus Tree Graffiti</title>
<style>
  *{box-sizing:border-box}
  html,body{height:100%;margin:0;background:#07070a;overflow:hidden;
            font:12px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;color:#e8e8f0}
  #c{display:block;width:100vw;height:100vh}
  #hud{position:fixed;left:14px;bottom:14px;display:flex;gap:8px;align-items:center;
       padding:8px 10px;border-radius:10px;background:rgba(12,12,18,.72);
       backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.10);z-index:5}
  #hud input{width:170px;background:#111119;border:1px solid #2a2a38;color:#e8e8f0;
             padding:6px 8px;border-radius:7px;font:inherit;outline:none}
  #hud input:focus{border-color:#FF4FA3}
  button{background:#17171f;border:1px solid #2a2a38;color:#e8e8f0;padding:6px 12px;
         border-radius:7px;font:inherit;cursor:pointer;transition:.15s}
  button:hover{background:#22222e;border-color:#3a3a4c}
  button:active{transform:translateY(1px)}
  #meta{position:fixed;right:14px;bottom:14px;text-align:right;font-size:11px;
        color:#6a6a80;z-index:5;max-width:46vw;line-height:1.6}
  #meta b{color:#b9b9d0;font-weight:600}
  #meta span.k{color:#4a4a60}
</style>
</head>
<body>
<canvas id="c"></canvas>

<div id="hud">
  <input id="seed" value="HIMELO-0001" spellcheck="false">
  <button id="go">Re-roll</button>
  <button id="save">PNG</button>
</div>

<div id="meta">
  <div><span class="k">WORD ·</span> <b id="m-word">—</b></div>
  <div><span class="k">AUTO ·</span> <b id="m-auto">—</b></div>
  <div><span class="k">TREE ·</span> <b id="m-tree">—</b></div>
  <div><span class="k">ART ·</span> <b id="m-art">—</b></div>
</div>

<script>
(() => {
'use strict';

/* ════════════════════════════════════════════════════════════
   0 · DETERMINISTIC RNG
   ════════════════════════════════════════════════════════════ */
function hashStr(s){
  let h = 2166136261 >>> 0;
  for (let i=0;i<s.length;i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
  return h >>> 0;
}
function mulberry32(a){
  return function(){
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

/* ════════════════════════════════════════════════════════════
   1 · AEIOU PALETTES (vowel layer)
   ════════════════════════════════════════════════════════════ */
const AEIOU = {
  A:{ p:'#FF4FA3', s:'#FFC2E0', ink:'#2A0016' },
  E:{ p:'#FF5A2B', s:'#FFC46B', ink:'#2A0A00' },
  I:{ p:'#F6F1E3', s:'#FFFFFF', ink:'#0E0E12' },
  O:{ p:'#2FE08A', s:'#8CF2FF', ink:'#00261A' },
  U:{ p:'#3D6BFF', s:'#B14CFF', ink:'#000B33' }
};

/* ════════════════════════════════════════════════════════════
   2 · CONSONANT CLASSES (articulacy layer)
   ════════════════════════════════════════════════════════════ */
const LETTER_CLASS = {
  B:'plosive', C:'plosive', D:'plosive', G:'plosive', K:'plosive',
  P:'plosive', Q:'plosive', T:'plosive',
  F:'fricative', H:'fricative', S:'fricative', V:'fricative', Z:'fricative', X:'fricative',
  J:'affricate',
  M:'nasal', N:'nasal',
  W:'approximant', Y:'approximant',
  R:'trill', L:'lateral'
};
const CLASS_COLOR = {
  plosive:     { p:'#FF7A1A', s:'#FFD08A', ink:'#2A1000' },
  fricative:   { p:'#00D1B2', s:'#A8FFF0', ink:'#00201C' },
  affricate:   { p:'#C6FF3D', s:'#F2FFB8', ink:'#1A2400' },
  nasal:       { p:'#B26BFF', s:'#E4CCFF', ink:'#1A0033' },
  approximant: { p:'#FFD400', s:'#FFF3B0', ink:'#2A2000' },
  lateral:     { p:'#2AA8FF', s:'#B8E2FF', ink:'#001A2A' },
  trill:       { p:'#FF2E63', s:'#FFB3C4', ink:'#2A0010' },
  tap:         { p:'#9AA0A6', s:'#DDE1E6', ink:'#141418' },
  vowel:       { p:'#E8E8F0', s:'#FFFFFF', ink:'#0B0B10' }
};

// Articulation → drawing weights
const ARTICULATION = {
  plosive:     { edge:1.30, drip:1.80, glow:0.30, spray:0.40, label:'pl' },
  fricative:   { edge:0.88, drip:0.90, glow:0.55, spray:1.40, label:'fr' },
  affricate:   { edge:1.15, drip:1.60, glow:0.40, spray:1.00, label:'af' },
  nasal:       { edge:1.00, drip:1.20, glow:0.85, spray:0.60, label:'na' },
  approximant: { edge:0.82, drip:0.80, glow:0.65, spray:0.80, label:'ap' },
  lateral:     { edge:1.05, drip:1.20, glow:0.45, spray:0.60, label:'la' },
  trill:       { edge:1.20, drip:2.00, glow:0.50, spray:0.50, label:'tr' },
  tap:         { edge:0.95, drip:1.00, glow:0.35, spray:1.00, label:'ta' },
  vowel:       { edge:1.00, drip:1.10, glow:0.70, spray:0.50, label:'vo' }
};

function paletteFor(ch){
  const u = ch.toUpperCase();
  if (AEIOU[u]) return AEIOU[u];
  return CLASS_COLOR[LETTER_CLASS[u] || 'approximant'];
}
function artClassFor(ch){
  const u = ch.toUpperCase();
  if (AEIOU[u]) return 'vowel';
  return LETTER_CLASS[u] || 'approximant';
}
function artStyleFor(ch){
  return ARTICULATION[artClassFor(ch)] || ARTICULATION.approximant;
}

/* ════════════════════════════════════════════════════════════
   3 · AUTOMATON  M = (S, Σ, δ, s₀, F)
   ════════════════════════════════════════════════════════════ */
const SIGMA = ['qp','dp','qb','db','∅','§','∆','©'];
const DELTA = {
  S1:{qp:'S2',dp:'S1',qb:'S3',db:'S2','∅':'S1','§':'S4','∆':'S3','©':'S5'},
  S2:{qp:'S3',dp:'S2',qb:'S4',db:'S1','∅':'S2','§':'S5','∆':'S4','©':'S1'},
  S3:{qp:'S4',dp:'S3',qb:'S5',db:'S2','∅':'S3','§':'S1','∆':'S5','©':'S2'},
  S4:{qp:'S5',dp:'S4',qb:'S1',db:'S3','∅':'S4','§':'S2','∆':'S1','©':'S3'},
  S5:{qp:'S1',dp:'S5',qb:'S2',db:'S4','∅':'S5','§':'S3','∆':'S2','©':'S4'}
};

/* ════════════════════════════════════════════════════════════
   4 · LEXICON + SIGILS
   ════════════════════════════════════════════════════════════ */
const LEX = [
  'HIMELO','AEIOU','RHOMBUS','HELIX','SURGE','SWAY','HEAVE',
  'YAW','PITCH','ROLL','CADIUS','OCTOVIRIS','PENTALLIUM',
  'HEXACORPUS','FORCE','POWER','AXIOM','ARTICULATE','TRUE'
];
const SIGILS = ['⅄','ᘔ','И','⇦','⇨','❴','❵','∧','ɿ','⊥'];
const FONT = '"Impact","Haettenschweiler","Arial Black","Franklin Gothic Heavy",sans-serif';

/* ════════════════════════════════════════════════════════════
   5 · CANVAS
   ════════════════════════════════════════════════════════════ */
const cv  = document.getElementById('c');
const ctx = cv.getContext('2d');
let W = 0, H = 0, DPR = 1;

function resize(){
  DPR = Math.min(2, window.devicePixelRatio || 1);
  W = cv.clientWidth; H = cv.clientHeight;
  cv.width  = Math.round(W * DPR);
  cv.height = Math.round(H * DPR);
}

/* ════════════════════════════════════════════════════════════
   6 · DRAW HELPERS
   ════════════════════════════════════════════════════════════ */
function shade(hex, amt){
  const n = parseInt(hex.slice(1), 16);
  let r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
  r = Math.round(r * (1 - amt));
  g = Math.round(g * (1 - amt));
  b = Math.round(b * (1 - amt));
  return `rgb(${r},${g},${b})`;
}

function drip(x, y, len, w, color){
  ctx.fillStyle = color;
  ctx.beginPath();
  ctx.moveTo(x - w * 0.5, y);
  ctx.quadraticCurveTo(x - w * 0.42, y + len * 0.72, x - w * 0.18, y + len * 0.92);
  ctx.quadraticCurveTo(x, y + len * 1.04, x + w * 0.18, y + len * 0.92);
  ctx.quadraticCurveTo(x + w * 0.42, y + len * 0.72, x + w * 0.5, y);
  ctx.closePath();
  ctx.fill();
  ctx.beginPath();
  ctx.arc(x, y + len * 1.02, w * 0.44, 0, Math.PI * 2);
  ctx.fill();
}

function sparkle(x, y, r, color){
  ctx.beginPath();
  ctx.moveTo(x, y - r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.quadraticCurveTo(x, y, x, y + r);
  ctx.quadraticCurveTo(x, y, x - r, y);
  ctx.quadraticCurveTo(x, y, x, y - r);
  ctx.fillStyle = color;
  ctx.fill();
}

function arrow(x, y, size, dir, color){
  ctx.save();
  ctx.translate(x, y);
  ctx.scale(dir, 1);
  ctx.beginPath();
  ctx.moveTo(-size * 0.5, -size * 0.16);
  ctx.lineTo( size * 0.10, -size * 0.16);
  ctx.lineTo( size * 0.10, -size * 0.38);
  ctx.lineTo( size * 0.55,  0);
  ctx.lineTo( size * 0.10,  size * 0.38);
  ctx.lineTo( size * 0.10,  size * 0.16);
  ctx.lineTo(-size * 0.5,   size * 0.16);
  ctx.closePath();
  ctx.fillStyle = color;
  ctx.fill();
  ctx.lineWidth = size * 0.07;
  ctx.strokeStyle = '#08080c';
  ctx.lineJoin = 'round';
  ctx.stroke();
  ctx.restore();
}

function crown(cx, y, w, color){
  const h = w * 0.52;
  ctx.beginPath();
  ctx.moveTo(cx - w * 0.5, y);
  ctx.lineTo(cx - w * 0.5, y - h * 0.55);
  ctx.lineTo(cx - w * 0.25, y - h * 0.16);
  ctx.lineTo(cx, y - h * 0.85);
  ctx.lineTo(cx + w * 0.25, y - h * 0.16);
  ctx.lineTo(cx + w * 0.5, y - h * 0.55);
  ctx.lineTo(cx + w * 0.5, y);
  ctx.closePath();
  ctx.fillStyle = color;
  ctx.fill();
  ctx.lineWidth = w * 0.045;
  ctx.lineJoin = 'round';
  ctx.strokeStyle = '#08080c';
  ctx.stroke();
}

function sprayDots(cx, cy, radius, density, color, rng){
  const count = Math.floor(density * 26);
  for (let i = 0; i < count; i++){
    const a = rng() * Math.PI * 2;
    const d = radius * (0.88 + rng() * 0.4);
    const x = cx + Math.cos(a) * d;
    const y = cy + Math.sin(a) * d;
    const r = 0.4 + rng() * 1.9;
    ctx.globalAlpha = 0.2 + rng() * 0.45;
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.globalAlpha = 1;
}

// Rhombus = diamond with 4 vertices (top / right / bottom / left)
function drawRhombus(cx, cy, size, rotation, fill, light, outlineWeight, glow){
  ctx.save();
  ctx.translate(cx, cy);
  ctx.rotate(rotation);

  const pts = [[0,-size],[size,0],[0,size],[-size,0]];

  if (glow > 0){
    ctx.shadowColor = fill;
    ctx.shadowBlur  = size * glow;
  }

  ctx.beginPath();
  ctx.moveTo(pts[0][0], pts[0][1]);
  for (let i = 1; i < 4; i++) ctx.lineTo(pts[i][0], pts[i][1]);
  ctx.closePath();

  ctx.lineJoin = 'round';
  ctx.lineWidth = size * outlineWeight;
  ctx.strokeStyle = '#08080c';
  ctx.stroke();

  ctx.shadowBlur = 0;
  const g = ctx.createLinearGradient(0, -size, 0, size);
  g.addColorStop(0,    light);
  g.addColorStop(0.5,  fill);
  g.addColorStop(1,    shade(fill, 0.45));
  ctx.fillStyle = g;
  ctx.fill();

  ctx.restore();
}

/* ════════════════════════════════════════════════════════════
   7 · RHOMBUS TREE BUILDER
   -----------------------------------------------------------------
   Z (heave)  → spine level (one letter per level)
   Y (sway)   → lateral offset per level  ∈ [-1, 0, +1]
   X (surge)  → edge length / node scale
   Roll       → rhombus rotation per node
   Side branches = 3-ary children per level (Y ∈ {-1, 0, +1})
   ════════════════════════════════════════════════════════════ */
function buildRhombusTree(word, rng, W, H){
  const letters = word.split('');
  const n = letters.length;

  const baseX  = W / 2;
  const baseY  = H * 0.80;
  const topY   = H * 0.18;
  const span   = baseY - topY;

  const nodes = [];
  let prev = null;
  let cumSway = 0;
  let swayAmp = W * 0.13;

  for (let i = 0; i < n; i++){
    const t = n > 1 ? i / (n - 1) : 0.5;

    // Y — sway: accumulate a drift, clamp to [-1, +1]
    const swayStep = (rng() - 0.5) * 1.4;         // -0.7 .. +0.7
    cumSway += swayStep * (0.6 + rng() * 0.6);
    const sway = Math.max(-1, Math.min(1, cumSway));

    // X — surge: edge length / scale multiplier
    const surge = 0.65 + rng() * 0.75;            // 0.65 .. 1.40

    // Roll — rhombus rotation
    const roll = (rng() - 0.5) * 0.7;             // -0.35 .. +0.35 rad

    // position
    const x = baseX + sway * swayAmp * (1 - t * 0.55) + (rng() - 0.5) * 18;
    const y = baseY - t * span;

    const palette = paletteFor(letters[i]);
    const art     = artStyleFor(letters[i]);

    const node = {
      x, y, z:i, t,
      sway, swayStep, surge, roll,
      letter:  letters[i].toUpperCase(),
      palette, art,
      parent:  prev,
      children:[],
      sideBranches:[]
    };
    nodes.push(node);
    if (prev) prev.children.push(node);
    prev = node;
  }

  // Side branches: 3-ary at each level, Y ∈ {-1, 0, +1} (0 = spine, already placed)
  for (const node of nodes){
    const want = rng() < 0.72 ? (rng() < 0.45 ? 2 : 1) : 0;
    const usedDirs = [];
    for (let b = 0; b < want; b++){
      let dir = rng() < 0.5 ? -1 : 1;
      if (usedDirs.includes(dir)) dir = -dir;
      usedDirs.push(dir);

      const len    = (0.10 + rng() * 0.17) * Math.min(W, H);
      const lean   = dir * (0.55 + rng() * 0.42);
      const angle  = node.roll + lean;
      const bx     = node.x + Math.sin(angle) * len;
      const by     = node.y - Math.cos(angle) * len;

      const tip    = rng() < 0.55 ? 'rhombus' : (rng() < 0.55 ? 'spark' : 'drip');

      node.sideBranches.push({
        x: bx, y: by, dir, angle,
        size: (0.35 + rng() * 0.32) * node.surge,
        roll: angle + (rng() - 0.5) * 0.35,
        tip,
        palette: paletteFor(letters[(rng() * n) | 0])
      });
    }
  }

  return { nodes, word };
}

/* ════════════════════════════════════════════════════════════
   8 · RENDER
   ════════════════════════════════════════════════════════════ */
const OUT = { word:'—', auto:'—', tree:'—', art:'—' };

function render(seed){
  const rng    = mulberry32(hashStr(seed));
  const rr     = (a,b) => a + (b-a) * rng();
  const pick   = arr  => arr[(rng() * arr.length) | 0];
  const chance = p    => rng() < p;

  /* 8a — run the automaton --------------------------------- */
  let st = 'S1';
  const path = [st], syms = [];
  for (let i = 0; i < 14; i++){
    const sym = pick(SIGMA);
    syms.push(sym);
    st = DELTA[st][sym];
    path.push(st);
  }
  const count = s => syms.filter(x => x === s).length;

  /* 8b — style vector ------------------------------------- */
  const style = {
    tilt:    rr(-0.05, 0.05) + count('∆') * 0.012,
    shear:   rr(-0.10, 0.10),
    edgeMul: 1 + count('qb') * 0.08 + count('dp') * 0.04,
    dripMul: 1 + count('∅') * 0.30,
    glowMul: 0.8 + count('qp') * 0.10,
    arrowN:  count('§'),
    sparkleN: 5 + count('©') * 2
  };

  /* 8c — word + tree -------------------------------------- */
  const word = pick(LEX);
  const tree = buildRhombusTree(word, rng, W, H);

  /* 8d — clear + wall ------------------------------------- */
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  ctx.clearRect(0, 0, W, H);

  const bg = ctx.createRadialGradient(
    W * 0.5, H * 0.45, 0,
    W * 0.5, H * 0.5, Math.max(W, H) * 0.78
  );
  bg.addColorStop(0,    '#14141c');
  bg.addColorStop(0.55, '#0c0c12');
  bg.addColorStop(1,    '#050508');
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, W, H);

  // ambient tint from first letter's palette
  const hero = tree.nodes[0].palette;
  const tint = ctx.createRadialGradient(
    W * 0.5, H * 0.42, 0,
    W * 0.5, H * 0.45, Math.max(W, H) * 0.70
  );
  tint.addColorStop(0,   hero.p);
  tint.addColorStop(0.45, shade(hero.p, 0.55));
  tint.addColorStop(1,   'transparent');
  ctx.globalAlpha = 0.10;
  ctx.fillStyle = tint;
  ctx.fillRect(0, 0, W, H);
  ctx.globalAlpha = 1;

  // wall speckle
  for (let i = 0; i < 1200; i++){
    ctx.globalAlpha = rr(0.01, 0.05);
    ctx.fillStyle = chance(0.5) ? '#fff' : '#000';
    ctx.fillRect(rr(0, W), rr(0, H), 1.2, 1.2);
  }
  ctx.globalAlpha = 1;

  /* 8e — enter tree space --------------------------------- */
  ctx.save();
  ctx.translate(W / 2, H * 0.5);
  ctx.rotate(style.tilt);
  ctx.transform(1, 0, style.shear, 1, 0, 0);
  ctx.translate(-W / 2, -H * 0.5);

  /* PASS A · spine edges (thick spray strokes) ----------- */
  for (let i = 1; i < tree.nodes.length; i++){
    const a = tree.nodes[i - 1];
    const b = tree.nodes[i];
    const mx = (a.x + b.x) / 2 + (rng() - 0.5) * 26;
    const my = (a.y + b.y) / 2 + (rng() - 0.5) * 20;

    // dark base
    ctx.strokeStyle = 'rgba(8,8,12,0.92)';
    ctx.lineWidth = b.surge * 20 * style.edgeMul;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(a.x, a.y);
    ctx.quadraticCurveTo(mx, my, b.x, b.y);
    ctx.stroke();

    // colored inner
    ctx.strokeStyle = b.palette.p;
    ctx.globalAlpha = 0.55;
    ctx.lineWidth = b.surge * 11 * style.edgeMul;
    ctx.stroke();
    ctx.globalAlpha = 1;
  }

  /* PASS B · side branches -------------------------------- */
  for (const node of tree.nodes){
    for (const br of node.sideBranches){
      const mx = (node.x + br.x) / 2 + (rng() - 0.5) * 18;
      const my = (node.y + br.y) / 2 + (rng() - 0.5) * 18;

      ctx.strokeStyle = 'rgba(8,8,12,0.75)';
      ctx.lineWidth = br.size * 14 * style.edgeMul;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(node.x, node.y);
      ctx.quadraticCurveTo(mx, my, br.x, br.y);
      ctx.stroke();

      ctx.strokeStyle = br.palette.p;
      ctx.globalAlpha = 0.45;
      ctx.lineWidth = br.size * 7 * style.edgeMul;
      ctx.stroke();
      ctx.globalAlpha = 1;
    }
  }

  /* PASS C · side-branch tips ----------------------------- */
  for (const node of tree.nodes){
    for (const br of node.sideBranches){
      const r = br.size * 28;
      if (br.tip === 'rhombus'){
        drawRhombus(
          br.x, br.y, r * 0.6, br.roll,
          br.palette.p, br.palette.s,
          0.14 * style.edgeMul, 0.4 * style.glowMul
        );
      } else if (br.tip === 'spark'){
        sparkle(br.x, br.y, r * 0.35, br.palette.s);
      } else {
        drip(br.x, br.y, r * 1.4, r * 0.18, shade(br.palette.p, 0.15));
      }
      // spray halo
      if (chance(0.4)){
        sprayDots(br.x, br.y, r * 0.9, br.palette ? 0.5 : 0, br.palette.s, rng);
      }
    }
  }

  /* PASS D · spine nodes: rhombus + letter + articulation - */
  for (const node of tree.nodes){
    // size curve: middle letters slightly larger
    const midBoost = Math.sin(node.t * Math.PI) * 0.35 + 0.82;
    const size = (16 + node.surge * 22) * midBoost;

    const art = node.art;

    // rhombus frame
    drawRhombus(
      node.x, node.y,
      size * 1.15,              // rhombus bigger than letter
      node.roll,
      node.palette.p,
      node.palette.s,
      0.14 * art.edge * style.edgeMul,
      0.5 * art.glow * style.glowMul
    );

    // spray halo around the rhombus (articulation-driven)
    if (art.spray > 0.3){
      sprayDots(node.x, node.y, size * 1.15, art.spray, node.palette.s, rng);
    }

    // letter inside — slightly counter-rotated for legibility
    ctx.save();
    ctx.translate(node.x, node.y);
    ctx.rotate(node.roll * 0.65);

    const fs = size * 1.10;
    ctx.font = `900 ${fs}px ${FONT}`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

