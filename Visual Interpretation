/* ════════════════════════════════════════════════════════════
   7 · SUMMARY PANEL  (drawn on canvas, included in PNG)
   ════════════════════════════════════════════════════════════ */
function drawPruneSummaryPanel(tree, W, H){
  // aggregate counts (skip silent, they aren't stubs)
  const counts = {};
  let total = 0;
  let silentCap = 0;
  let kept = 0;
  for (const node of tree.nodes){
    kept += node.keptBranches.length;
    for (const { br } of node.prunedBranches){
      if (br.silent){ silentCap++; continue; }
      const r = br.reason || '·';
      counts[r] = (counts[r] || 0) + 1;
      total++;
    }
  }
  const rows = Object.entries(counts).sort((a,b) => b[1] - a[1]);
  if (rows.length === 0 && silentCap === 0) return;

  const pad     = 14;
  const rowH    = 20;
  const panelW  = 232;
  const headerH = 34;
  const footerH = 40;
  const panelH  = headerH + rows.length * rowH + footerH;
  const px      = W - panelW - 18;
  const py      = 18;

  // panel frame
  ctx.save();
  ctx.fillStyle   = 'rgba(12,12,18,0.85)';
  ctx.strokeStyle = 'rgba(255,255,255,0.10)';
  ctx.lineWidth   = 1;
  roundRect(px, py, panelW, panelH, 10);
  ctx.fill();
  ctx.stroke();

  // title
  ctx.fillStyle = 'rgba(232,232,240,0.92)';
  ctx.font = '700 11px ui-monospace,monospace';
  ctx.textAlign = 'left';
  ctx.textBaseline = 'top';
  ctx.fillText('PRUNE HEATMAP', px + 14, py + 12);

  // rows
  const maxCount = rows.length ? rows[0][1] : 1;
  const barW  = 78;
  const barX  = px + panelW - pad - barW - 26;
  rows.forEach((row, i) => {
    const [reason, count] = row;
    const info = PRUNE_COLORS[reason] || PRUNE_COLORS['·'];
    const y = py + headerH + i * rowH;

    // swatch
    ctx.fillStyle = info.color;
    ctx.fillRect(px + 14, y + 4, 10, 10);

    // label
    ctx.fillStyle = 'rgba(232,232,240,0.82)';
    ctx.font = '500 10px ui-monospace,monospace';
    ctx.fillText(info.label, px + 30, y + 5);

    // bar
    const bw = (count / maxCount) * barW;
    ctx.fillStyle = info.color;
    ctx.globalAlpha = 0.6;
    ctx.fillRect(barX, y + 3, bw, 10);
    ctx.globalAlpha = 1;

    // count
    ctx.fillStyle = 'rgba(232,232,240,0.92)';
    ctx.textAlign = 'right';
    ctx.fillText(count.toString(), px + panelW - pad, y + 5);
    ctx.textAlign = 'left';
  });

  // footer
  const fy = py + headerH + rows.length * rowH + 10;
  ctx.fillStyle = 'rgba(232,232,240,0.65)';
  ctx.font = '500 10px ui-monospace,monospace';
  const fired = rows.length ? `${rows[0][0]} (${rows[0][1]}/${total})` : '—';
  ctx.fillText(`fired ${fired}`, px + 14, fy);
  ctx.fillText(`kept ${kept} · silent-cap ${silentCap}`, px + 14, fy + 14);
  ctx.restore();
}

/* ════════════════════════════════════════════════════════════
   8 · PRUNE RULES
   ════════════════════════════════════════════════════════════ */
const STATE_BUDGET = { S1:0, S2:1, S3:2, S4:2, S5:0 };

function applyPruneRules(node, candidates){
  const kept = [];
  const pruned = [];
  let pool = candidates.slice();
  const sym = node.symbol || '∅';
  const st  = node.state  || 'S1';

  if (sym === '∅'){
    for (const br of pool) pruned.push({ br, reason:'∅' });
    return { kept, pruned };
  }

  const filter = (pred, reason) => {
    const next = [];
    for (const br of pool){
      if (pred(br)) next.push(br);
      else pruned.push({ br, reason });
    }
    pool = next;
  };
  if (sym === 'qp') filter(br => br.dir > 0, 'qp');
  if (sym === 'dp') filter(br => br.dir < 0, 'dp');

  const swaySign = node.sway >= 0 ? 1 : -1;
  if (sym === '©') filter(br => br.dir === swaySign, '©');
  if (sym === '∆') filter(br => br.dir !== swaySign, '∆');

