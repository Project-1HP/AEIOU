  // partial dashed stub (all modes)
  const t = 0.30;
  const ex = node.x + (br.x - node.x) * t;
  const ey = node.y + (br.y - node.y) * t;

  ctx.save();
  ctx.setLineDash([3, 4]);
  ctx.strokeStyle = mode === 0 ? 'rgba(150,150,175,0.55)' : info.color;
  ctx.globalAlpha = mode === 0 ? 1 : 0.75;
  ctx.lineWidth = 2;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(node.x, node.y);
  ctx.lineTo(ex, ey);
  ctx.stroke();
  ctx.setLineDash([]);

  // × at cut
  const r = 5;
  ctx.strokeStyle = mode === 0 ? 'rgba(220,90,140,0.85)' : info.color;
  ctx.globalAlpha = mode === 0 ? 1 : 0.95;
  ctx.lineWidth = 1.8;
  ctx.beginPath();
  ctx.moveTo(ex - r, ey - r);
  ctx.lineTo(ex + r, ey + r);
  ctx.moveTo(ex + r, ey - r);
  ctx.lineTo(ex - r, ey + r);
  ctx.stroke();

  // reason tag
  if (br.reason && br.reason.length <= 3){
    ctx.globalAlpha = mode === 0 ? 0.55 : 0.85;
    ctx.font = '600 9px ui-monospace,monospace';
    ctx.fillStyle = mode === 0 ? 'rgba(220,90,140,0.9)' : info.color;
