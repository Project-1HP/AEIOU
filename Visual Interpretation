function drawHeatBlob(x, y, r, color){
  const g = ctx.createRadialGradient(x, y, 0, x, y, r);
  g.addColorStop(0,    color + 'AA');
  g.addColorStop(0.35, color + '66');
  g.addColorStop(0.7,  color + '22');
  g.addColorStop(1,    color + '00');
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.arc(x, y, r, 0, Math.PI * 2);
  ctx.fill();
}

function drawPruneStub(node, br, mode){
  // mode: 0=off (grey) · 1=overlay (coloured) · 2=heat (coloured + ghost + blob)
  const info = PRUNE_COLORS[br.reason] || PRUNE_COLORS['·'];

  // full-length ghost (heat mode only)
  if (mode === 2){
    ctx.save();
    ctx.strokeStyle = info.color;
    ctx.globalAlpha = 0.16;
    ctx.lineWidth = 2.5;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(node.x, node.y);
    ctx.lineTo(br.x, br.y);
    ctx.stroke();
    ctx.restore();
